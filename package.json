{
  "name": "@link17528/pi-session-deck",
  "version": "1.0.2",
  "type": "module",
  "description": "Keyboard-first session browsing and management for Pi",
  "license": "MIT",
  "homepage": "https://github.com/De0ta/PiSessionDeck#readme",
  "bugs": {
    "url": "https://github.com/De0ta/PiSessionDeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/De0ta/PiSessionDeck.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/install.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "prepublishOnly": "npm run check && npm test && npm run smoke:package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <1.5.0",
    "@earendil-works/pi-tui": ">=1.4.0 <1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
