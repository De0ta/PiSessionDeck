{
  "name": "pi-session-viewer",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Lightweight session browser extension for Pi",
  "license": "MIT",
  "homepage": "https://github.com/De0ta/PiSessionViewer#readme",
  "bugs": {
    "url": "https://github.com/De0ta/PiSessionViewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/De0ta/PiSessionViewer.git"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/install.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:install": "node scripts/smoke-install.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <1.5.0",
    "@earendil-works/pi-tui": ">=1.4.0 <1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
